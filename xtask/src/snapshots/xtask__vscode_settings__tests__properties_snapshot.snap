---
source: xtask/src/vscode_settings.rs
expression: generated_properties()
---
{
  "jjpwrgem.path": {
    "type": "string",
    "default": "jjp",
    "scope": "machine",
    "markdownDescription": "Path to the `jjp` executable used to run the language server. Defaults to `jjp` on your `PATH`. Reload the window after changing."
  },
  "jjpwrgem.format.mode": {
    "type": "string",
    "enum": [
      "pretty",
      "uglify"
    ],
    "enumDescriptions": [
      "Pretty print with indentation and line breaks",
      "Remove all insignificant whitespace, also known as minifying"
    ],
    "default": "pretty",
    "markdownDescription": "Output style.",
    "order": 0
  },
  "jjpwrgem.format.preferredWidth": {
    "type": "integer",
    "minimum": 0,
    "default": 80,
    "markdownDescription": "Preferred maximum line width. Note this is not a hard maximum width. Ignored when `#jjpwrgem.format.mode#` is `uglify`.",
    "order": 1
  },
  "jjpwrgem.format.endOfLine": {
    "type": "string",
    "enum": [
      "lf",
      "crlf"
    ],
    "enumDescriptions": [
      "Unix line endings (LF)",
      "Windows line endings (CRLF)"
    ],
    "default": "lf",
    "markdownDescription": "Line ending to use when formatting output.",
    "order": 2
  },
  "jjpwrgem.trace.server": {
    "type": "string",
    "enum": [
      "off",
      "messages",
      "verbose"
    ],
    "enumDescriptions": [
      "No tracing",
      "Trace requests and notifications",
      "Trace requests and notifications with their payloads"
    ],
    "default": "off",
    "scope": "window",
    "markdownDescription": "Traces the communication between VS Code and the jjpwrgem language server."
  }
}
